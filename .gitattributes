# Normalize line endings across Linux/macOS/Windows.
* text=auto eol=lf

# Windows-specific scripts keep CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binary types.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.tar   binary
*.tar.gz binary
*.gz    binary

# Rust + Node lockfiles stay text.
Cargo.lock text
pnpm-lock.yaml text
