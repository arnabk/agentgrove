{
  "name": "agentgrove-monorepo",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter ./apps/* build",
    "dev": "pnpm --filter @agentgrove/web dev",
    "test": "pnpm -r --filter ./apps/* test",
    "test:e2e": "pnpm --filter @agentgrove/web test:e2e",
    "lint": "pnpm -r --filter ./apps/* lint",
    "typecheck": "pnpm -r --filter ./apps/* typecheck",
    "format": "pnpm -r --filter ./apps/* format"
  }
}
